#ifndef __CONFIG_H__
#define __CONFIG_H__

#define SCIP_BUILD_TYPE "@CMAKE_BUILD_TYPE@"
#define SCIP_VERSION_MAJOR @SCIP_VERSION_MAJOR@
#define SCIP_VERSION_MINOR @SCIP_VERSION_MINOR@
#define SCIP_VERSION_PATCH @SCIP_VERSION_PATCH@
#define SCIP_VERSION_API @SCIP_VERSION_API@

#cmakedefine01 BMS_HAS_NOBLOCKMEM
#cmakedefine01 SCIP_HAS_NOBUFFERMEM
#cmakedefine01 SCIP_HAS_DEBUG_SOLUTION
#cmakedefine SCIP_NO_SIGACTION
#cmakedefine SCIP_NO_STRTOK_R
#cmakedefine WITH_SCIPDEF
#cmakedefine01 SCIP_HAS_LAPACK
