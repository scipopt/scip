# Racing configuration 7: large neighborhood search improver.
# Fires the LNS heuristics aggressively and immediately on new incumbents
# (nwaitingnodes = 0), so solutions published by the other concurrent solvers
# are polished as soon as they arrive through the solution pool; separation is
# throttled to leave the CPU to the LNS sub-MIPs.

heuristics/rins/freq = 10
heuristics/rins/nwaitingnodes = 0
heuristics/rins/minimprove = 0.001
heuristics/rins/nodesquot = 0.5
heuristics/rins/maxnodes = 10000
heuristics/crossover/freq = 10
heuristics/crossover/nwaitingnodes = 0
heuristics/crossover/dontwaitatroot = TRUE
heuristics/crossover/nusedsols = 4
heuristics/crossover/minimprove = 0.001
heuristics/dins/freq = 15
heuristics/localbranching/freq = 25
heuristics/mutation/freq = 25
heuristics/trustregion/freq = 25

# --- relaxation-based LNS (works before the first incumbent, too) ---
heuristics/rens/freq = 15
heuristics/gins/freq = 10

# --- keep the own tree cheap; CPU belongs to the sub-MIPs ---
separating/maxrounds = 1
separating/maxroundsroot = 5
